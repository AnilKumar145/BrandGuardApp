# ==============================================================================
# BrandGuard Environment Configuration
# ==============================================================================

# Database Connection
# Supabase PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Local Docker Postgres: postgresql://brandguard:brandguard_secret@localhost:5432/brandguard_db
DATABASE_URL="postgresql://brandguard:brandguard_secret@localhost:5432/brandguard_db"

# Redis Cache (Optional for MVP)
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
SECRET_KEY="brandguard_production_secret_key_change_in_prod_2026"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Server Port
PORT=3000

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
